{
  "name": "agent-toolbox-2",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Agent Toolbox 2 — a research workspace preview",
  "author": "guoshaung",
  "license": "MIT",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "build": "tsc --noEmit && vite build && node scripts/build.mjs",
    "start": "npm run build && electron .",
    "dev": "node scripts/dev.mjs",
    "test": "node scripts/build.mjs && node --test test/backend.test.cjs test/bridge.test.cjs",
    "test:ui": "npm run build && electron scripts/smoke.cjs",
    "pack": "npm run build && electron-builder --win dir --x64",
    "dist:win": "npm run build && electron-builder --win portable --x64",
    "test:migration": "npm run build && electron scripts/smoke-migration.cjs",
    "legacy:prepare": "node scripts/prepare-legacy-bridge.cjs"
  },
  "dependencies": {
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "prettier": "3.6.2",
    "typescript": "^5.9.3",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "cn.macpe.agenttoolbox.v2.preview",
    "productName": "Agent Toolbox 2 Preview",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "portable"
      ],
      "artifactName": "Agent-Toolbox-2-Preview-${version}-win-x64.${ext}"
    },
    "portable": {
      "requestExecutionLevel": "user"
    }
  }
}
